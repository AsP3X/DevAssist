<?xml version="1.0" encoding="UTF-8"?>
<!--
  MSI installer for artcraft-repos. Built with the WiX Toolset (v4 or v5):

    wix build installer\artcraft-repos.wxs -arch x64 ^
      -d Version=0.2.0 -d ExePath=target\release\artcraft-repos.exe ^
      -o target\installer\artcraft-repos-0.2.0-x64.msi

  installer\build.ps1 does this with the version from Cargo.toml.

  Installs for all users into Program Files, adds a Start menu shortcut and
  puts the folder on the system PATH. A newer version replaces an older one.
  The UpgradeCode must never change: it is how Windows knows two versions
  are the same product.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Artcraft Repos"
      Manufacturer="Artcraft"
      Version="$(var.Version)"
      UpgradeCode="F21E52B4-5D95-42C8-9E4A-C266FB78B010"
      Scope="perMachine"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation Description="Manager for local GitHub repositories" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Artcraft Repos is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The app has no repair or change options: Programs and Features only
         offers Uninstall. -->
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Artcraft Repos">
        <Component Id="MainExecutable" Guid="*">
          <File Id="AppExe" Name="artcraft-repos.exe" Source="$(var.ExePath)" KeyPath="yes" />
          <!-- So `artcraft-repos` works in any terminal. Removed on uninstall. -->
          <Environment
              Id="PathEntry"
              Name="PATH"
              Value="[INSTALLFOLDER]"
              Part="last"
              Action="set"
              System="yes"
              Permanent="no" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut
            Id="AppShortcut"
            Name="Artcraft Repos"
            Description="Manage local GitHub repositories"
            Target="[INSTALLFOLDER]artcraft-repos.exe" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Artcraft Repos"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Artcraft Repos" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
